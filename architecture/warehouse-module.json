  "cards": [
    {
      "dot": "emerald",
      "title": "Write and read back",
      "items": [
        "Create and Update call WarehouseRequest on the plan; the API client sends the warehouse request to Lakekeeper",
        "Create, Read and Update then call Refresh with the prior (plan, or state in Read) and the server's warehouse",
        "readServerWarehouse converts the storage profile and delete profile from the server for both Refresh and the data source"
      ]
    },
    {
      "dot": "rose",
      "title": "Storage credential",
      "items": [
        "Lakekeeper never returns the storage credential; api.Warehouse has no field for it",
        "WarehouseRequest takes it from the configuration; Refresh copies it from the prior",
        "If the storage profile's type changed on the server, or the prior has no storage profile (after import), it stays null",
        "The data source never holds a storage credential"
      ]
    },
    {
      "dot": "violet",
      "title": "Storage profile and delete profile",
      "items": [
        "Exactly one of S3 (or S3-compatible), ADLS or GCS is set; anything else is an error",
        "The delete profile is hard, or soft with expiration_seconds; an absent one is sent as hard",
        "The resource and the data source share this module's schemas and conversions; the data-source schema has no credential"
      ]
    }
  ]
