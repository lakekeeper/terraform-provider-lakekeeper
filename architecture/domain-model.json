  "cards": [
    {
      "dot": "cyan",
      "title": "Ownership",
      "items": [
        "A user belongs to the server, never to a project; it only holds grants there",
        "A role, a warehouse and its namespaces belong to one project",
        "The default project is an ordinary project; the nil UUID selects it"
      ]
    },
    {
      "dot": "violet",
      "title": "Role on both sides",
      "items": [
        "As an assignee, a role receives grants at any scope",
        "As a scope, a role has users and other roles assigned to it (ownership, assignee)",
        "Lakekeeper rejects assigning a role to itself"
      ]
    },
    {
      "dot": "amber",
      "title": "Assignment resources",
      "items": [
        "Server, project, warehouse and role scopes: one resource for a role assignee and one for a user assignee",
        "Namespace scope: a role assignee only (lakekeeper_namespace_role_assignment)",
        "Each manages one assignee's grants at one scope; other assignees' grants are left alone"
      ]
    }
  ]
